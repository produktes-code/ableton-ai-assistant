{
  "name": "antigravity-app",
  "version": "2.0.0",
  "description": "Asistente de IA para Ableton Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node -e \"console.log('Electron tests delegated to pytest UI structure suite')\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.antigravity.assistant",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
