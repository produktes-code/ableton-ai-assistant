{
  "name": "antigravity-app",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Produktes-code/ableton-ai-assistant.git"
  },
  "description": "Asistente de IA para Ableton Live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node -e \"console.log('Electron tests delegated to pytest UI structure suite')\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.antigravity.assistant",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  }
}
