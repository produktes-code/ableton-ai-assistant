{
  "name": "ableton-ai-assistant",
  "version": "2.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Produktes-code/ableton-ai-assistant.git"
  },
  "description": "Asistente de IA para Ableton Live",
  "author": {
    "name": "Produktes-code",
    "email": "produktes.code@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node -e \"console.log('Electron tests delegated to pytest UI structure suite')\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.antigravity.assistant",
    "productName": "Ableton.AI.Assistant",
    "artifactName": "Ableton.AI.Assistant-${version}.${ext}",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Ableton.AI.Assistant.Setup.${version}.${ext}"
    },
    "linux": {
      "target": [
        {"target": "AppImage", "arch": ["x64"]},
        {"target": "deb", "arch": ["x64"]}
      ],
      "category": "Audio",
      "maintainer": "produktes-code",
      "description": "Antigravity AI Assistant for Ableton Live"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  }
}
